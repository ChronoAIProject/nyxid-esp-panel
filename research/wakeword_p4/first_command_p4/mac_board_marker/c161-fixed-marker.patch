diff --git a/components/panel_services/fixed_marker/board_marker.cpp b/components/panel_services/fixed_marker/board_marker.cpp
new file mode 100644
index 00000000..91fb9559
--- /dev/null
+++ b/components/panel_services/fixed_marker/board_marker.cpp
@@ -0,0 +1,44 @@
+#include "board_marker.h"
+#include "c161_coded_cue_reference_v5.h"
+#include "c161_panel_echo_confirmation.h"
+#include "c161_panel_middle_marker.h"
+#include "c161_timed_final_marker.h"
+#include "panel_marker_pair.h"
+#include "reference_activity.h"
+#include "reference_prefix.h"
+#include "reference_signature.h"
+#include "reference_wake.h"
+#include <new>
+#include <type_traits>
+
+struct board_marker {
+    nyx::TimedFinalMarker cue;
+    nyx::PanelMiddleMarker mic_middle;
+    nyx::PanelMarkerPair ref_pair;
+    nyx::PanelEchoConfirmation echo;
+    nyx::CodedCueReferenceV5 full;
+    nyx::ReferenceActivity activity;
+    nyx::ReferenceSignature signature;
+    nyx::ReferencePrefix prefix;
+    nyx::ReferenceWake model_route, cue_route;
+};
+
+static_assert(alignof(board_marker) <= 8 && std::is_trivially_destructible_v<board_marker>);
+
+size_t board_marker_bytes(void) { return sizeof(board_marker); }
+board_marker_t *board_marker_begin(void *storage) { return new (storage) board_marker{}; }
+
+unsigned board_marker_step(board_marker_t *s, int16_t mic, int16_t ref, bool model_hit, bool tx_pair) {
+    const bool matched = s->cue.update(mic);
+    const bool active = s->activity.update(ref);
+    const bool panel_clear = s->echo.allow_model(s->ref_pair.update(ref), tx_pair, s->mic_middle.update(mic));
+    const bool full_clear = s->full.allow(ref, true);
+    s->signature.update(ref);
+    using State = nyx::ReferencePrefix::State;
+    const auto prefix = s->prefix.update(ref, [&] { return s->signature.matches(); });
+    const bool ref_clear = full_clear && prefix != State::confirmed;
+    const bool waiting = prefix == State::awaiting_third;
+    const bool cue = s->cue_route.update_active(active, ref_clear, matched, waiting);
+    const bool model = s->model_route.update_active(active, ref_clear && panel_clear, model_hit, waiting);
+    return (model ? BOARD_MARKER_C161 : 0) | (cue ? BOARD_MARKER_CUE : 0);
+}
