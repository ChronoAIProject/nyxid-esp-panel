+++ b/components/panel_services/fixed_marker/panel_marker_pair.h
@@ -0,0 +1,59 @@
+#pragma once
+#include <cstdint>
+#include "c161_coded_cue_coefficients_v5.h"
+
+namespace nyx {
+// Feed consecutive mono PCM16 at 16 kHz. Only the distributed v4 cue carries both patterns.
+class PanelMarkerPair {
+public:
+    bool update(std::int16_t pcm) {
+        sum_ += pcm;
+        if (++phase_ < 4) return false;
+        const int block = sum_ / 16;
+        fir_[fir_cursor_] = fir_[fir_cursor_ + 17] = block;
+        fir_cursor_ = (fir_cursor_ + 1) % 17;
+        int filtered = 0;
+        for (int i = 0; i < 17; ++i)
+            filtered += fir_[fir_cursor_ + i] * kCueBandFirV5[16 - i];
+        const int sample = filtered / 128;
+        sum_ = phase_ = 0;
+        const int old = ring_[cursor_];
+        energy_ += sample * sample - old * old;
+        ring_[cursor_] = ring_[cursor_ + 320] = sample;
+        cursor_ = (cursor_ + 1) % 320;
+        slot_ = (slot_ + 1) & 1023;
+        // The two patterns traverse the same channel. Require the same correlation sign
+        // and the 160 ms spacing, allowing 1.5 ms for clock and arrival differences.
+        const int entering = first_[(slot_ + 1024 - 640 + 6) & 1023];
+        const int leaving = first_[(slot_ + 1024 - 640 - 7) & 1023];
+        positive_ += (entering > 0) - (leaving > 0);
+        negative_ += (entering < 0) - (leaving < 0);
+        first_[slot_] = 0;
+        if (cooldown_ > 0) {
+            --cooldown_;
+            return false;
+        }
+        if (!energy_) return false;
+        first_[slot_] = sign(0);
+        if (!positive_ && !negative_) return false;
+        const int second = sign(1);
+        if (!((second > 0 && positive_) || (second < 0 && negative_))) return false;
+        cooldown_ = 8039;
+        return true;
+    }
+
+private:
+    int sign(int pattern) const {
+        std::int32_t dot = 0;
+        for (int i = 0; i < 320; ++i)
+            dot += ring_[cursor_ + i] * kCueBandPatternsV5[pattern + 1][i];
+        if (double(dot) * dot < 0.09 * kCueBandEnergyV5[pattern + 1] * energy_) return 0;
+        return dot > 0 ? 1 : -1;
+    }
+    std::int16_t ring_[640]{}, fir_[34]{};
+    int fir_cursor_ = 0;
+    std::int8_t first_[1024]{};
+    std::int64_t energy_ = 0;
+    int sum_ = 0, phase_ = 0, cursor_ = 0, slot_ = 0, positive_ = 0, negative_ = 0, cooldown_ = 0;
+};
+}  // namespace nyx
diff --git a/components/panel_services/fixed_marker/reference_activity.h b/components/panel_services/fixed_marker/reference_activity.h
new file mode 100644
index 00000000..119646aa
--- /dev/null
+++ b/components/panel_services/fixed_marker/reference_activity.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <cstdint>
+
+namespace nyx {
+// Emit one activity pulse at the end of each 10 ms frame whose AC RMS reaches
+// 64 PCM16 units. The wake and capture routes apply their existing hold times.
+class ReferenceActivity {
+public:
+    static constexpr int kFrame = 160;
+    static bool active_frame(const int16_t *pcm) {
+        int sum = 0;
+        int64_t energy = 0;
+        for (int i = 0; i < kFrame; ++i) {
+            sum += pcm[i];
+            energy += int(pcm[i]) * int(pcm[i]);
+        }
+        return above_floor(sum, energy);
+    }
+
+    bool update(int16_t sample) {
+        sum_ += sample;
+        energy_ += int(sample) * int(sample);
+        if (++count_ != kFrame) return false;
+        const bool active = above_floor(sum_, energy_);
+        count_ = sum_ = 0;
+        energy_ = 0;
+        return active;
+    }
+
+private:
+    static bool above_floor(int sum, int64_t energy) {
+        return kFrame * energy - int64_t(sum) * sum >= int64_t(kFrame * 64) * (kFrame * 64);
+    }
+    int count_ = 0, sum_ = 0;
+    int64_t energy_ = 0;
+};
+}
diff --git a/components/panel_services/fixed_marker/reference_prefix.h b/components/panel_services/fixed_marker/reference_prefix.h
new file mode 100644
index 00000000..be315d43
--- /dev/null
+++ b/components/panel_services/fixed_marker/reference_prefix.h
@@ -0,0 +1,32 @@
+#pragma once
+#include "c161_coded_cue_aligned_v4.h"
+
+namespace nyx {
+// The first two codes of the digital v5 reference precede the final code by
+// 120 ms. Bridge that interval, including the final matcher's 1.5 ms tolerance.
+class ReferencePrefix {
+public:
+    static constexpr int kWindowSamples = 1920 + 24;
+    enum class State { clear, confirmed, awaiting_third };
+
+    template <typename Qualify>
+    State update(std::int16_t reference, Qualify qualify) {
+        if (pair_.update(reference)) {
+            state_ = qualify() ? State::confirmed : State::awaiting_third;
+            remaining_ = kWindowSamples + 1;
+        }
+        if (!remaining_) return State::clear;
+        --remaining_;
+        return state_;
+    }
+
+    template <typename Qualify>
+    bool clear(std::int16_t reference, Qualify qualify) {
+        return update(reference, qualify) != State::confirmed;
+    }
+private:
+    AlignedCodedCueV4 pair_;
+    int remaining_ = 0;
+    State state_ = State::clear;
+};
+}
diff --git a/components/panel_services/fixed_marker/reference_signature.h b/components/panel_services/fixed_marker/reference_signature.h
new file mode 100644
index 00000000..6ca7bbfa
--- /dev/null
+++ b/components/panel_services/fixed_marker/reference_signature.h
@@ -0,0 +1,39 @@
+#pragma once
+#include <cstdint>
+
+namespace nyx {
+// Check only at a two-code match on the electrical reference. Compare 32 ms
+// from the middle of the frozen WAV's second code, tolerating level changes.
+class ReferenceSignature {
+public:
+    void update(std::int16_t sample) {
+        const std::uint32_t bit = 1u << (next_ & 31);
+        auto& word = history_[next_ >> 5];
+        if (sample > 0) word |= bit;
+        else word &= ~bit;
+        next_ = (next_ + 1) & 1023;
+    }
+
+    bool matches() const {
+        // Second code ends at 15680. Its sampled sign pattern starts at 14800.
+        for (int lag = 880 - 48; lag <= 880 + 48; ++lag) {
+            int errors = 0;
+            for (int i = 0; i < 128; ++i) {
+                const int slot = (1024 + next_ - lag + 4*i) & 1023;
+                const auto actual = (history_[slot >> 5] >> (slot & 31)) & 1u;
+                const auto expected = (kPattern[i >> 5] >> (31 - (i & 31))) & 1u;
+                errors += actual != expected;
+                if (errors > 12 && i + 1 - errors > 12) break;
+                if (i == 127) return true;
+            }
+        }
+        return false;
+    }
+
+private:
+    // Sign of digital v5 PCM[14800:15312:4], most significant bit first.
+    static constexpr std::uint32_t kPattern[4] = {0xb597fd99, 0xe723199e, 0x6d666b6c, 0xcd9cd24d};
+    std::uint32_t history_[32]{};
+    int next_ = 0;
+};
+}
diff --git a/components/panel_services/fixed_marker/reference_wake.h b/components/panel_services/fixed_marker/reference_wake.h
new file mode 100644
index 00000000..08493448
--- /dev/null
+++ b/components/panel_services/fixed_marker/reference_wake.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <cstdlib>
+#include <cstdint>
+
+namespace nyx {
+// A microphone decision can arrive shortly before the playback reference
+// completes its three v5 anchors. Allow one C161 stride during playback.
+class ReferenceWake {
+public:
+    bool update(int16_t reference, bool reference_clear, bool hit, bool awaiting_third = false) {
+        return update_active(std::abs(int(reference)) >= 64, reference_clear, hit, awaiting_third);
+    }
+
+    bool update_active(bool active, bool reference_clear, bool hit, bool awaiting_third) {
+        if (active) recent_ = 8001;
+        const bool playing = recent_ > 0;
+        if (playing) --recent_;
+        if (!reference_clear) {
+            pending_ = 0;
+            return false;
+        }
+        if (pending_) {
+            // Keep a due decision until a tentative pair expires or a full match cancels it.
+            if (pending_ == 1 && awaiting_third) return false;
+            if (--pending_ == 0) return true;
+        }
+        if (!hit) return false;
+        if (playing) pending_ = 480;
+        else if (awaiting_third) pending_ = 1;
+        else return true;
+        return false;
+    }
+
+private:
+    int recent_ = 0, pending_ = 0;
+};
+}
