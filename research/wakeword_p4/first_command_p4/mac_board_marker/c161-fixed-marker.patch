diff --git a/components/panel_services/fixed_marker/c161_coded_cue_reference_v5.h b/components/panel_services/fixed_marker/c161_coded_cue_reference_v5.h
new file mode 100644
index 00000000..f8b12f57
--- /dev/null
+++ b/components/panel_services/fixed_marker/c161_coded_cue_reference_v5.h
@@ -0,0 +1,24 @@
+#pragma once
+#include "c161_coded_cue_v5.h"
+
+namespace nyx {
+// Feed the raw playback reference at the sample index of the processed mic output.
+// The mic matcher can be shared with the existing v5 path. Each result is one tick.
+class CodedCueReferenceV5 {
+public:
+    bool allow(std::int16_t reference, bool mic_hit) {
+        if (reference_detector_.update(reference)) {
+            remaining_ = kWindowSamples + 1;
+        }
+        const bool suppress = remaining_ > 0;
+        if (suppress) --remaining_;
+        return mic_hit && !suppress;
+    }
+
+    // Measured zero-reference frontend latency plus eight 256-sample AEC partitions.
+    static constexpr int kWindowSamples = 1440 + 8 * 256;
+private:
+    CodedCueV5 reference_detector_;
+    int remaining_ = 0;
+};
+}
diff --git a/components/panel_services/fixed_marker/c161_coded_cue_v5.h b/components/panel_services/fixed_marker/c161_coded_cue_v5.h
new file mode 100644
index 00000000..7d51fa0c
--- /dev/null
+++ b/components/panel_services/fixed_marker/c161_coded_cue_v5.h
@@ -0,0 +1,69 @@
+#pragma once
+#include <cstdint>
+#include "c161_coded_cue_coefficients_v5.h"
+
+namespace nyx {
+// Feed consecutive mono PCM16 at 16 kHz. Only the distributed v5 cue carries the three patterns.
+class CodedCueV5 {
+public:
+    bool update(std::int16_t pcm) {
+        sum_ += pcm;
+        if (++phase_ < 4) return false;
+        const int block = sum_ / 16;
+        fir_[fir_cursor_] = fir_[fir_cursor_ + 17] = block;
+        fir_cursor_ = (fir_cursor_ + 1) % 17;
+        int filtered = 0;
+        for (int i = 0; i < 17; ++i)
+            filtered += fir_[fir_cursor_ + i] * kCueBandFirV5[16 - i];
+        const int sample = filtered / 128;
+        sum_ = phase_ = 0;
+        const int old = ring_[cursor_];
+        energy_ += sample * sample - old * old;
+        ring_[cursor_] = ring_[cursor_ + 320] = sample;
+        cursor_ = (cursor_ + 1) % 320;
+        slot_ = (slot_ + 1) & 1023;
+        // Look for the next known pattern 160 ms or 120 ms after its predecessor.
+        // A matched chain keeps one polarity, allowing 1.5 ms of relative arrival error.
+        for (int k = 0; k < 2; ++k) {
+            const int delay = k == 0 ? 640 : 480;
+            const int entering = signs_[k][(slot_ + 1024 - delay + 6) & 1023];
+            const int leaving = signs_[k][(slot_ + 1024 - delay - 7) & 1023];
+            positive_[k] += (entering > 0) - (leaving > 0);
+            negative_[k] += (entering < 0) - (leaving < 0);
+            signs_[k][slot_] = 0;
+        }
+        if (cooldown_ > 0) {
+            --cooldown_;
+            return false;
+        }
+        if (!energy_) return false;
+        signs_[0][slot_] = sign(0);
+        if (positive_[0] || negative_[0]) {
+            const int second = sign(1);
+            if (consistent(0, second)) signs_[1][slot_] = second;
+        }
+        if (!positive_[1] && !negative_[1]) return false;
+        if (!consistent(1, sign(2))) return false;
+        cooldown_ = 8039;
+        return true;
+    }
+
+private:
+    bool consistent(int k, int sign) const {
+        return (sign > 0 && positive_[k]) || (sign < 0 && negative_[k]);
+    }
+
+    int sign(int pattern) const {
+        std::int32_t dot = 0;
+        for (int i = 0; i < 320; ++i)
+            dot += ring_[cursor_ + i] * kCueBandPatternsV5[pattern][i];
+        if (double(dot) * dot < 0.09 * kCueBandEnergyV5[pattern] * energy_) return 0;
+        return dot > 0 ? 1 : -1;
+    }
+    std::int16_t ring_[640]{}, fir_[34]{};
+    int fir_cursor_ = 0;
+    std::int8_t signs_[2][1024]{};
+    std::int64_t energy_ = 0;
+    int sum_ = 0, phase_ = 0, cursor_ = 0, slot_ = 0, positive_[2]{}, negative_[2]{}, cooldown_ = 0;
+};
+}  // namespace nyx
diff --git a/components/panel_services/fixed_marker/c161_panel_demo_guard.h b/components/panel_services/fixed_marker/c161_panel_demo_guard.h
