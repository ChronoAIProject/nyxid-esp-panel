+#pragma once
+
+namespace nyx {
+// Call once per 16 kHz capture sample on the listener thread. The optional
+// speaker event is the panel demonstration's B,C marker pair on the playout
+// clock, mapped to this capture clock. A queued or cancelled playback request
+// alone supplies no event. Keep feeding the physical R to the AEC and FIFO.
+class PanelDemoGuard {
+public:
+    bool allow_model(bool reference_pair, bool played_pair) {
+        if (reference_pair || played_pair) remaining_ = kTailSamples + 1;
+        if (remaining_ == 0) return true;
+        --remaining_;
+        return false;
+    }
+    static constexpr int kTailSamples = 1944 + 3488;
+
+private:
+    int remaining_ = 0;
+};
+}  // namespace nyx
diff --git a/components/panel_services/fixed_marker/c161_panel_echo_confirmation.h b/components/panel_services/fixed_marker/c161_panel_echo_confirmation.h
new file mode 100644
index 00000000..775eb839
--- /dev/null
+++ b/components/panel_services/fixed_marker/c161_panel_echo_confirmation.h
@@ -0,0 +1,33 @@
+#pragma once
+#include "c161_panel_demo_guard.h"
+
+namespace nyx {
+// Inputs are consumed in capture-sample order. Corroborate the known panel's
+// B,C playout event with the same pair heard on the microphone, in either order.
+class PanelEchoConfirmation {
+public:
+    bool allow_model(bool reference_pair, bool played_pair, bool mic_pair) {
+        age(played_age_, played_pair);
+        age(mic_age_, mic_pair);
+        if (reference_pair)
+            remaining_ = PanelDemoGuard::kTailSamples + 1;
+        if ((played_pair || mic_pair) && played_age_ <= kSkew && mic_age_ <= kSkew) {
+            const int tail = PanelDemoGuard::kTailSamples + 1 - mic_age_;
+            if (tail > remaining_) remaining_ = tail;
+        }
+        if (!remaining_) return true;
+        --remaining_;
+        return false;
+    }
+
+private:
+    static constexpr int kSkew = 1280;
+    static void age(int& value, bool fresh) {
+        if (fresh) value = 0;
+        else if (value <= kSkew) ++value;
+    }
+    int played_age_ = kSkew + 1;
+    int mic_age_ = kSkew + 1;
+    int remaining_ = 0;
+};
+}  // namespace nyx
