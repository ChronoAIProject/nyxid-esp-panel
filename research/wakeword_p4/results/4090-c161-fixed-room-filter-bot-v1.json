    {
      "source": {
        "key": "af_kore_digital",
        "voice": "af_kore",
        "transport": "digital",
        "spans": [
          {
            "text": "Hello there. How can I help you today?",
            "group": "reply",
            "start": 0,
            "end": 40800,
            "source_clipped": 0
          },
          {
            "text": "Your next appointment starts in six minutes.",
            "group": "reply",
            "start": 48800,
            "end": 98000,
            "source_clipped": 0
          },
          {
            "text": "I've set the kitchen timer for six minutes.",
            "group": "reply",
            "start": 106000,
            "end": 153200,
            "source_clipped": 0
          },
          {
            "text": "I turned the study lamp off.",
            "group": "reply",
            "start": 161200,
            "end": 194400,
            "source_clipped": 0
          },
          {
            "text": "The next train leaves from platform six.",
            "group": "reply",
            "start": 202400,
            "end": 248000,
            "source_clipped": 0
          },
          {
            "text": "Nick sent you a message about dinner.",
            "group": "reply",
            "start": 256000,
            "end": 296000,
            "source_clipped": 0
          },
          {
            "text": "Max asked me to remind you about the keys.",
            "group": "reply",
            "start": 304000,
            "end": 350000,
            "source_clipped": 0
          },
          {
            "text": "Nicole will pick you up at the station.",
            "group": "reply",
            "start": 358000,
            "end": 399600,
            "source_clipped": 0
          },
          {
            "text": "I've added milk and eggs to your shopping list.",
            "group": "reply",
            "start": 407600,
            "end": 457600,
            "source_clipped": 0
          },
          {
            "text": "The forecast is clear skies this afternoon.",
            "group": "reply",
            "start": 465600,
            "end": 514400,
            "source_clipped": 0
          },
          {
            "text": "Your music is paused. Shall I play the next track?",
            "group": "reply",
            "start": 522400,
            "end": 574800,
            "source_clipped": 0
          },
          {
            "text": "I couldn't hear that. Could you repeat your request?",
            "group": "reply",
            "start": 582800,
            "end": 633200,
            "source_clipped": 0
          },
          {
            "text": "To wake me, say Hey Nicks.",
            "group": "explicit_mention",
            "start": 641200,
            "end": 676400,
            "source_clipped": 0
          },
          {
            "text": "Hey Nicks, turn on the kitchen lights.",
            "group": "explicit_mention",
            "start": 684400,
            "end": 722800,
            "source_clipped": 0
          }
        ],
        "samples": 730800,
