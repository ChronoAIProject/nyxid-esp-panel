        "source": {
          "key": "melo-BR_stream",
          "spans": [
            {
              "address": "nyx_connected_command",
              "text": "Hey Nicks, could you switch off the study lamp?",
              "start": 0,
              "end": 45326
            },
            {
              "address": "ordinary_conversation",
              "text": "I thought the parcel was arriving on Thursday, but it came this morning.",
              "start": 53326,
              "end": 118900
            },
            {
              "address": "ordinary_conversation",
              "text": "Could you move your bag so that I can sit beside the window?",
              "start": 126900,
              "end": 181885
            },
            {
              "address": "ordinary_name_address",
              "text": "Hey Nick, could you switch off the study lamp?",
              "start": 189885,
              "end": 234282
            },
            {
              "address": "nyx_connected_command",
              "text": "Hey Nicks, please remind me to take the bread out in twelve minutes.",
              "start": 242282,
              "end": 306741
            },
            {
              "address": "ordinary_conversation",
              "text": "We have already eaten, so please do not wait for us.",
              "start": 314741,
              "end": 367869
            },
            {
              "address": "ordinary_conversation",
              "text": "She said the shop closes early on Sundays.",
              "start": 375869,
              "end": 420080
            },
            {
              "address": "ordinary_name_address",
              "text": "Hey Nick, please remind me to take the bread out in twelve minutes.",
              "start": 428080,
              "end": 491610
            },
            {
              "address": "nyx_connected_command",
              "text": "Hey Nicks, is there any rain expected this afternoon?",
              "start": 499610,
              "end": 554967
            },
            {
              "address": "ordinary_conversation",
              "text": "There is a little more soup in the pot if you are still hungry.",
              "start": 562967,
              "end": 616281
            },
            {
              "address": "ordinary_conversation",
              "text": "I cannot find my glasses, although I was wearing them a moment ago.",
              "start": 624281,
              "end": 688554
            },
            {
              "address": "ordinary_name_address",
              "text": "Hey Nick, is there any rain expected this afternoon?",
              "start": 696554,
              "end": 750796
            },
            {
              "address": "nyx_connected_command",
              "text": "Hey Nicks, lower the music so I can answer the phone.",
              "start": 758796,
              "end": 810438
            },
            {
              "address": "ordinary_conversation",
              "text": "The children would rather stay indoors until the rain stops.",
              "start": 818438,
              "end": 873609
            },
            {
              "address": "ordinary_conversation",
              "text": "Let me finish this message before we leave for the station.",
              "start": 881609,
              "end": 931765
            },
            {
              "address": "ordinary_name_address",
              "text": "Hey Nick, lower the music so I can answer the phone.",
              "start": 939765,
              "end": 991592
            },
            {
              "address": "nyx_connected_command",
              "text": "Hey Nicks, I would like to hear the news while I make breakfast.",
              "start": 999592,
              "end": 1057735
            },
            {
              "address": "ordinary_common_words",
              "text": "After the next announcement, we should know which platform to use.",
              "start": 1065735,
              "end": 1128151
            },
            {
              "address": "ordinary_common_words",
              "text": "I was hoping to visit next month, if the trains are running.",
              "start": 1136151,
              "end": 1193551
            },
            {
              "address": "ordinary_name_address",
              "text": "Nick, did you remember to bring the charger from the car?",
              "start": 1201551,
              "end": 1253750
            },
            {
              "address": "nyx_connected_command",
              "text": "Hey Nicks, put milk and apples on my shopping list.",
              "start": 1261750,
              "end": 1311906
            },
            {
              "address": "ordinary_common_words",
              "text": "You need to mix it slowly or the sauce will become lumpy.",
              "start": 1319906,
              "end": 1376563
            },
            {
              "address": "ordinary_common_words",
              "text": "This playlist has a mixture of old songs and newer recordings.",
              "start": 1384563,
              "end": 1448093
            },
            {
              "address": "ordinary_name_address",
              "text": "I spoke to Nick yesterday and he is feeling much better.",
              "start": 1456093,
              "end": 1508478
            },
            {
              "address": "nyx_connected_command",
              "text": "Hey Nicks, leave the hallway light on until I get upstairs.",
              "start": 1516478,
              "end": 1573878
            },
            {
              "address": "ordinary_common_words",
              "text": "There are six people waiting outside and another two on the stairs.",
              "start": 1581878,
              "end": 1644665
            },
            {
              "address": "ordinary_common_words",
              "text": "The price was sixty pounds, including delivery.",
              "start": 1652665,
              "end": 1701335
            },
            {
              "address": "ordinary_name_address",
              "text": "Hey Nicky, your breakfast is getting cold.",
              "start": 1709335,
              "end": 1755218
            },
            {
              "address": "nyx_connected_command",
              "text": "Hey Nicks, tell me how long the journey to the airport will take.",
              "start": 1763218,
              "end": 1824333
            },
            {
              "address": "ordinary_common_words",
              "text": "I found a nice little cafe near the museum yesterday.",
              "start": 1832333,
              "end": 1884160
            },
            {
              "address": "ordinary_common_words",
              "text": "That fixes the problem with the kitchen cupboard.",
              "start": 1892160,
              "end": 1936557
            },
            {
              "address": "ordinary_name_address",
              "text": "Hey Alex, would you mind answering the door?",
              "start": 1944557,
              "end": 1985982
            },
            {
              "address": "nyx_connected_command",
              "text": "Hey Nicks, pause the television for a moment please.",
              "start": 1993982,
              "end": 2045066
            },
            {
              "address": "ordinary_household",
              "text": "Would you leave a small light on in the kitchen tonight?",
              "start": 2053066,
              "end": 2099506
            },
            {
              "address": "ordinary_household",
              "text": "The timer should ring just before the potatoes are ready.",
              "start": 2107506,
              "end": 2161934
            },
            {
              "address": "ordinary_name_address",
              "text": "Hey Mike, I think you left your coat in the hallway.",
              "start": 2169934,
              "end": 2221204
            },
            {
              "address": "nyx_connected_command",
              "text": "Hey Nicks, make the room a little warmer before bedtime.",
              "start": 2229204,
              "end": 2284004
            },
            {
              "address": "ordinary_household",
              "text": "I turned the bedroom speaker down because the baby was asleep.",
              "start": 2292004,
              "end": 2347175
            },
            {
              "address": "ordinary_household",
              "text": "Please check whether the back door is locked before you go upstairs.",
              "start": 2355175,
              "end": 2412204
            },
            {
              "address": "ordinary_name_address",
              "text": "Hey Chris, the taxi will be here in a couple of minutes.",
              "start": 2420204,
              "end": 2476490
            },
            {
              "address": "nyx_connected_command",
              "text": "Hey Nicks, cancel the reminder about the laundry.",
              "start": 2484490,
              "end": 2533531
            },
            {
              "address": "ordinary_household",
              "text": "The washing machine has finished, but the clothes are still wet.",
              "start": 2541531,
              "end": 2600417
            },
            {
              "address": "ordinary_household",
              "text": "We can open the windows once the traffic has settled down.",
              "start": 2608417,
              "end": 2664331
            },
            {
              "address": "ordinary_name_address",
              "text": "Hey Max, can you carry the other bag upstairs?",
              "start": 2672331,
              "end": 2721558
            },
            {
              "address": "nyx_connected_command",
              "text": "Hey Nicks, do I have any appointments after lunch?",
              "start": 2729558,
              "end": 2781571
            },
            {
              "address": "ordinary_household",
              "text": "I will call you when the kettle starts boiling.",
              "start": 2789571,
              "end": 2830996
            },
            {
              "address": "ordinary_household",
              "text": "Please put the remote control back beside the sofa.",
              "start": 2838996,
              "end": 2887666
            },
            {
              "address": "ordinary_name_address",
              "text": "Hey Nicole, are we still meeting outside the cinema?",
              "start": 2895666,
              "end": 2946379
            }
          ],
