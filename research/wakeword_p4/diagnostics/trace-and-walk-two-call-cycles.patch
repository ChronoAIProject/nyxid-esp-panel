+static memory_snapshot_t memory_first,memory_second;
+static bool memory_walk(walker_heap_into_t heap,walker_block_info_t block,void *arg)
+{
+    (void)heap;memory_snapshot_t *s=arg;
+    if(block.used) {
+        if(s->count>=8192){s->overflow=true;return false;}
+        s->blocks[s->count++]=(memory_block_t){block.ptr,block.size};
+    }
+    return true;
+}
+static void memory_snapshot(memory_snapshot_t *s)
+{
+    s->count=0;s->overflow=false;heap_caps_walk(MALLOC_CAP_SPIRAM,memory_walk,s);
+    ESP_LOGI("panel.memtrace","walk blocks=%u overflow=%u psram_free=%u",(unsigned)s->count,s->overflow,(unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM));
+}
