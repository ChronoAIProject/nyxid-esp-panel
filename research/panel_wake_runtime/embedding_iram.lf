# Experimental performance mapping only. This does not make the detector
# cache-disabled-safe: model weights and tensor data may still be in PSRAM.
[mapping:nyx_embedding_hot_adapter]
archive: libpanel_wake_runtime.a
entries:
    embedding_runtime (noflash)

[mapping:nyx_embedding_hot_convolution]
archive: libespressif__esp-nn.a
entries:
    esp_nn_conv_esp32p4 (noflash)
    esp_nn_conv_opt (noflash)
