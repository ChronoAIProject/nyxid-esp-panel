# Build a patched copy of the pinned SDK driver. Never modify the user's IDF.
# Its normal VSYNC callback remains available; the LVGL bridge instead receives
# the actual DMA-selected framebuffer, so it cannot reuse a scanout buffer.
if(NOT IDF_VERSION_MAJOR EQUAL 5 OR NOT IDF_VERSION_MINOR EQUAL 5)
    message(FATAL_ERROR "Review the panel LCD compatibility backport for this IDF version")
endif()
set(_panel_lcd_compat "${CMAKE_BINARY_DIR}/panel_lcd_compat")
set(_panel_lcd_driver_rel "components/esp_lcd/dsi/esp_lcd_panel_dpi.c")
set(_panel_lcd_original "$ENV{IDF_PATH}/${_panel_lcd_driver_rel}")
set(_panel_lcd_patched "${_panel_lcd_compat}/${_panel_lcd_driver_rel}")
set(_panel_lcd_patch "${CMAKE_CURRENT_LIST_DIR}/../patches/esp_idf_5_5_dpi_scanout.patch")
configure_file("${_panel_lcd_original}" "${_panel_lcd_patched}" COPYONLY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_panel_lcd_patch}")
execute_process(COMMAND git apply --check "${_panel_lcd_patch}"
    WORKING_DIRECTORY "${_panel_lcd_compat}" RESULT_VARIABLE _panel_patch_check)
if(NOT _panel_patch_check EQUAL 0)
    message(FATAL_ERROR "Pinned IDF DPI scanout patch does not apply")
endif()
execute_process(COMMAND git apply "${_panel_lcd_patch}"
    WORKING_DIRECTORY "${_panel_lcd_compat}" RESULT_VARIABLE _panel_patch_apply)
if(NOT _panel_patch_apply EQUAL 0)
    message(FATAL_ERROR "Failed to patch the build-local DPI driver")
endif()
idf_component_get_property(_panel_lcd_lib esp_lcd COMPONENT_LIB)
get_target_property(_panel_lcd_sources ${_panel_lcd_lib} SOURCES)
set(_panel_lcd_replacements 0)
foreach(_panel_src IN LISTS _panel_lcd_sources)
    if(_panel_src MATCHES "(^|/)dsi/esp_lcd_panel_dpi[.]c$")
        list(REMOVE_ITEM _panel_lcd_sources "${_panel_src}")
        math(EXPR _panel_lcd_replacements "${_panel_lcd_replacements}+1")
    endif()
endforeach()
if(NOT _panel_lcd_replacements EQUAL 1)
    message(FATAL_ERROR "Expected exactly one SDK DPI driver source")
endif()
list(APPEND _panel_lcd_sources "${_panel_lcd_patched}")
set_property(TARGET ${_panel_lcd_lib} PROPERTY SOURCES "${_panel_lcd_sources}")
target_include_directories(${_panel_lcd_lib} PRIVATE
    "$ENV{IDF_PATH}/components/esp_lcd/dsi" "${CMAKE_CURRENT_LIST_DIR}/../compat/include")
idf_component_get_property(_panel_lvgl_lib espressif__esp_lvgl_adapter COMPONENT_LIB)
target_include_directories(${_panel_lvgl_lib} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../compat/include")
target_compile_definitions(${_panel_lvgl_lib} PRIVATE PANEL_DPI_DMA_SCANOUT_COMPAT=1)
