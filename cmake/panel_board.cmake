# Select hardware before ESP-IDF resolves Kconfig and components.
set(PANEL_BOARD_PROFILE "p4-rev1-16mb" CACHE STRING "Exact board/revision firmware profile")
find_program(PANEL_PROFILE_PYTHON NAMES python3 REQUIRED)
set(_panel_profile_tool "${CMAKE_CURRENT_LIST_DIR}/../tools/board_profiles.py")
set(_panel_catalog "${CMAKE_CURRENT_LIST_DIR}/../boards/catalog.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_panel_catalog}" "${_panel_profile_tool}")
function(panel_profile_command output)
    execute_process(COMMAND "${PANEL_PROFILE_PYTHON}" "${_panel_profile_tool}" ${ARGN}
        --profile "${PANEL_BOARD_PROFILE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE value ERROR_VARIABLE error
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Board profile configuration failed: ${error}")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
set(_panel_profile_stamp "${CMAKE_BINARY_DIR}/.panel-board-profile")
if(EXISTS "${_panel_profile_stamp}")
    file(READ "${_panel_profile_stamp}" _panel_cached_profile)
    if(NOT _panel_cached_profile STREQUAL PANEL_BOARD_PROFILE)
        message(FATAL_ERROR "Build directory belongs to ${_panel_cached_profile}, not ${PANEL_BOARD_PROFILE}. Use a separate build directory.")
    endif()
endif()
panel_profile_command(_panel_defaults defaults)
set(SDKCONFIG_DEFAULTS "${_panel_defaults}" CACHE STRING "Defaults from the board catalog" FORCE)
if(NOT DEFINED SDKCONFIG)
    set(SDKCONFIG "${CMAKE_BINARY_DIR}/sdkconfig" CACHE FILEPATH "Isolated board configuration")
endif()
panel_profile_command(PANEL_BOARD_BACKEND backend)
panel_profile_command(PANEL_BOARD_BSP_COMPONENT bsp-component)
panel_profile_command(PANEL_BOARD_BSP_ADAPTER bsp-adapter)
panel_profile_command(PANEL_BOARD_BSP_PATCH bsp-patch)
set(PANEL_BOARD_BACKEND "${PANEL_BOARD_BACKEND}" CACHE INTERNAL "Selected board backend" FORCE)
set(PANEL_BOARD_BSP_COMPONENT "${PANEL_BOARD_BSP_COMPONENT}" CACHE INTERNAL "Selected BSP dependency" FORCE)
set(PANEL_BOARD_GENERATED_DIR "${CMAKE_BINARY_DIR}/panel_board" CACHE INTERNAL "Generated board headers" FORCE)
panel_profile_command(_panel_header header --output "${PANEL_BOARD_GENERATED_DIR}/panel_board_config.h")
