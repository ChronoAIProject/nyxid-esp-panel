# Registry dependency rules reference these optional Hosted USB selectors even
# when the pinned Hosted component only provides this board's SDIO transport.
config ESP_HOSTED_HOST_USB_CDC_ACM_MANIFEST
    bool
    default n

config ESP_HOSTED_HOST_USB_CHERRYUSB_MANIFEST
    bool
    default n

config ESP_HOSTED_HOST_USB_RNDIS_MANIFEST
    bool
    default n
