+
+#if CONFIG_NYX_PANEL_BOARD_LCD_X8
+// The SDK's generic I2C panel IO waits forever. After a GT911 NACK with a
+// stuck-busy bus this spins inside the driver, starving LVGL and blocking the
+// audio codecs on the same bus. A finite timeout lets the driver reset its
+// I2C FSM and the next touch poll recover. Keep the external-screen BSP intact.
+#define LCD_X8_TOUCH_TIMEOUT_MS 50
+
+typedef struct {
+    esp_lcd_panel_io_t base;
+    i2c_master_dev_handle_t device;
+} lcd_x8_touch_io_t;
+
+static esp_err_t lcd_x8_touch_rx(esp_lcd_panel_io_t *base, int reg, void *data, size_t size)
+{
+    if (reg < 0 || reg > UINT16_MAX || !data || !size) return ESP_ERR_INVALID_ARG;
+    lcd_x8_touch_io_t *io = (lcd_x8_touch_io_t *)base;
+    uint8_t address[] = {reg >> 8, reg & 0xff};
+    return i2c_master_transmit_receive(io->device, address, sizeof(address), data, size,
+                                       LCD_X8_TOUCH_TIMEOUT_MS);
+}
+
+static esp_err_t lcd_x8_touch_tx(esp_lcd_panel_io_t *base, int reg, const void *data, size_t size)
+{
+    if (reg < 0 || reg > UINT16_MAX || (!data && size)) return ESP_ERR_INVALID_ARG;
+    lcd_x8_touch_io_t *io = (lcd_x8_touch_io_t *)base;
+    uint8_t address[] = {reg >> 8, reg & 0xff};
+    i2c_master_transmit_multi_buffer_info_t buffers[] = {
+        {.write_buffer = address, .buffer_size = sizeof(address)},
+        {.write_buffer = (uint8_t *)data, .buffer_size = size},
+    };
+    return i2c_master_multi_buffer_transmit(io->device, buffers, size ? 2 : 1,
+                                           LCD_X8_TOUCH_TIMEOUT_MS);
+}
+
+static esp_err_t lcd_x8_touch_del(esp_lcd_panel_io_t *base)
+{
+    lcd_x8_touch_io_t *io = (lcd_x8_touch_io_t *)base;
+    esp_err_t ret = i2c_master_bus_rm_device(io->device);
+    if (ret == ESP_OK) free(io);
+    return ret;
+}
+
+static esp_err_t lcd_x8_touch_io_new(const esp_lcd_panel_io_i2c_config_t *config,
+                                    esp_lcd_panel_io_handle_t *out)
+{
+    lcd_x8_touch_io_t *io = calloc(1, sizeof(*io));
+    if (!io) return ESP_ERR_NO_MEM;
+    i2c_device_config_t device = {
+        .device_address = config->dev_addr,
+        .scl_speed_hz = config->scl_speed_hz,
+    };
+    esp_err_t ret = i2c_master_bus_add_device(i2c_handle, &device, &io->device);
+    if (ret != ESP_OK) {
+        free(io);
+        return ret;
+    }
+    io->base.rx_param = lcd_x8_touch_rx;
+    io->base.tx_param = lcd_x8_touch_tx;
+    io->base.del = lcd_x8_touch_del;
+    *out = &io->base;
+    return ESP_OK;
+}
+#endif

