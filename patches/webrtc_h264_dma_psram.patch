--- a/espressif__esp_hosted/host/port/include/os_wrapper.h
+++ b/espressif__esp_hosted/host/port/include/os_wrapper.h
@@ -102,7 +102,7 @@
 /* without alignment */
 #define MALLOC(x)                        malloc(x)

