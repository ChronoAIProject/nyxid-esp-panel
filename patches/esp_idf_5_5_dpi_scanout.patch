+
+// Project-local compatibility API. Public IDF headers and the SDK checkout are
+// unchanged. The adapter only uses this with serialized full-frame buffering.
+esp_err_t panel_dpi_register_scanout_callback(esp_lcd_panel_handle_t panel,
+                                            panel_dpi_scanout_cb_t callback, void *ctx)
+{
+    ESP_RETURN_ON_FALSE(panel, ESP_ERR_INVALID_ARG, TAG, "invalid panel");
+    esp_lcd_dpi_panel_t *dpi_panel = __containerof(panel, esp_lcd_dpi_panel_t, base);
+#if CONFIG_LCD_DSI_ISR_CACHE_SAFE
+    ESP_RETURN_ON_FALSE(!callback || esp_ptr_in_iram(callback), ESP_ERR_INVALID_ARG, TAG, "scanout callback not in IRAM");
+    ESP_RETURN_ON_FALSE(!ctx || esp_ptr_internal(ctx), ESP_ERR_INVALID_ARG, TAG, "scanout context not in internal RAM");
+#endif
+    dpi_panel->on_scanout = NULL;
+    dpi_panel->scanout_ctx = ctx;
+    dpi_panel->on_scanout = callback;
+    return ESP_OK;
+}
+
+esp_err_t panel_dpi_get_scanout_buffer(esp_lcd_panel_handle_t panel,
+                                     const void **frame, size_t *size)
+{
+    ESP_RETURN_ON_FALSE(panel && frame && size, ESP_ERR_INVALID_ARG, TAG, "invalid scanout arguments");
+    esp_lcd_dpi_panel_t *dpi_panel = __containerof(panel, esp_lcd_dpi_panel_t, base);
+    *frame = atomic_load_explicit(&dpi_panel->scanout_frame, memory_order_acquire);
+    *size = dpi_panel->fb_size;
+    return *frame ? ESP_OK : ESP_ERR_INVALID_STATE;
+}
